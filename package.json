{
  "name": "stepby-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {"react": "^19.2.0", "react-dom": "^19.2.0"},
  "devDependencies": {"@playwright/test": "^1.56.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "esbuild": "^0.25.0", "typescript": "^5.9.0"}
}
