{
  "name": "stepby-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "npm run build && playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:robotics": "node scripts/test.mjs robotics",
    "check:architecture": "node --test tests/source-layout.test.cjs",
    "preview": "node scripts/preview.mjs",
    "pretest": "npm run build",
    "pretest:robotics": "npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
